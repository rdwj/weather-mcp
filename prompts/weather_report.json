{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "description": "Brief overview of current conditions"
    },
    "temperature": {
      "type": "object",
      "properties": {
        "current": {
          "type": "string",
          "description": "Current temperature with units"
        },
        "feels_like": {
          "type": "string",
          "description": "Perceived temperature accounting for wind/humidity"
        },
        "context": {
          "type": "string",
          "description": "Temperature in context (e.g., seasonal norms)"
        }
      },
      "required": ["current", "context"]
    },
    "conditions": {
      "type": "object",
      "properties": {
        "sky": {
          "type": "string",
          "description": "Sky conditions"
        },
        "precipitation": {
          "type": "string",
          "description": "Any precipitation occurring or expected"
        },
        "visibility": {
          "type": "string",
          "description": "Visibility conditions if notable"
        }
      },
      "required": ["sky"]
    },
    "wind": {
      "type": "object",
      "properties": {
        "speed": {
          "type": "string",
          "description": "Wind speed with units"
        },
        "direction": {
          "type": "string",
          "description": "Wind direction"
        },
        "impact": {
          "type": "string",
          "description": "Practical impact of wind conditions"
        }
      },
      "required": ["speed"]
    },
    "recommendations": {
      "type": "object",
      "properties": {
        "clothing": {
          "type": "string",
          "description": "Appropriate clothing for conditions"
        },
        "activities": {
          "type": "string",
          "description": "Suitable outdoor activities"
        },
        "cautions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Any weather-related cautions"
        }
      },
      "required": ["clothing", "activities"]
    }
  },
  "required": ["summary", "temperature", "conditions", "recommendations"]
}