{
  "type": "object",
  "properties": {
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Location name"
          },
          "temperature": {
            "type": "string",
            "description": "Current temperature"
          },
          "conditions": {
            "type": "string",
            "description": "Current weather conditions"
          },
          "wind": {
            "type": "string",
            "description": "Wind conditions"
          },
          "humidity": {
            "type": "string",
            "description": "Humidity level"
          }
        },
        "required": ["name", "temperature", "conditions"]
      },
      "description": "List of locations with their weather data"
    },
    "temperature_analysis": {
      "type": "object",
      "properties": {
        "warmest": {
          "type": "string",
          "description": "Warmest location and temperature"
        },
        "coolest": {
          "type": "string",
          "description": "Coolest location and temperature"
        },
        "range": {
          "type": "string",
          "description": "Temperature range across locations"
        },
        "comfort_winner": {
          "type": "string",
          "description": "Most comfortable temperature considering all factors"
        }
      },
      "required": ["warmest", "coolest", "range"]
    },
    "conditions_comparison": {
      "type": "object",
      "properties": {
        "best_weather": {
          "type": "string",
          "description": "Location with best overall conditions"
        },
        "worst_weather": {
          "type": "string",
          "description": "Location with most challenging conditions"
        },
        "precipitation": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Locations with precipitation"
        },
        "clear_skies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Locations with clear conditions"
        }
      },
      "required": ["best_weather"]
    },
    "activity_recommendations": {
      "type": "object",
      "properties": {
        "outdoor_sports": {
          "type": "string",
          "description": "Best location for outdoor sports"
        },
        "sightseeing": {
          "type": "string",
          "description": "Best location for sightseeing"
        },
        "beach_pool": {
          "type": "string",
          "description": "Best location for beach/pool activities"
        },
        "hiking": {
          "type": "string",
          "description": "Best location for hiking"
        }
      }
    },
    "travel_advisory": {
      "type": "string",
      "description": "Any weather-related travel considerations"
    },
    "summary": {
      "type": "string",
      "description": "Overall comparison summary with key takeaways"
    }
  },
  "required": ["locations", "temperature_analysis", "conditions_comparison", "summary"]
}